#!/bin/bash
# Gateway node: the gateway and, in front of it, the frontend (nginx), which
# serves the SPA and proxies /api/ to the gateway. Rendered by Terraform
# (templatefile): $${...} are Terraform values, plain $VARS are shell variables.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

# Wait until the images exist: the instance can boot before CI (or a
# manual push) has published them, and Docker Hub can fail for a moment.
for image in "${image}" "${frontend_image}"; do
  until docker pull "$image"; do
    echo "image $image not available yet, retrying in 30 s" >&2
    sleep 30
  done
done

# Both containers share a network, so nginx reaches the gateway by name. Only
# nginx publishes a port: the gateway is not reachable from outside the host.
docker network create dfsha || true

# GATEWAY_ADDR must be 0.0.0.0: the default 127.0.0.1 is unreachable from
# outside the container. Variable names come from crates/gateway/src/main.rs.
docker run -d --name gateway --restart always \
  --network dfsha \
  -e GATEWAY_ADDR="0.0.0.0:${port}" \
  -e MASTER_ADDRESS="http://${master_addr}:50051" \
  -e JWT_SECRET="${jwt_secret}" \
  -e GATEWAY_ENCRYPTION_KEY="${encryption_key}" \
  -e RUST_LOG=gateway=info \
  "${image}"

docker run -d --name frontend --restart always \
  --network dfsha \
  -p ${frontend_port}:80 \
  -e GATEWAY_UPSTREAM="gateway:${port}" \
  "${frontend_image}"
