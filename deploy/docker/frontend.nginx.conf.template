# Rendered by the nginx image at start: ${GATEWAY_UPSTREAM} comes from the
# environment, every other $var is an nginx variable.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;

    # Docker's embedded DNS. Resolving per request (through a variable) lets
    # nginx start before the gateway container and follow it if it restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway http://${GATEWAY_UPSTREAM};

    # Health check of the public NLB.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Uploads and downloads are streamed by the gateway: no size limit and no
    # buffering here, or nginx would hold whole files on its disk first.
    location /api/ {
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Vite fingerprints the assets, so they can be cached for good.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: any other path is a client-side route of react-router.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
