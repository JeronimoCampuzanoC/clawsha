# Keep the Docker build context small: no build artifacts, no git, no state.
target/
**/target/
**/node_modules/
.git/
.dynamodb-local/
infra/**/.terraform/
*.tfstate*

# Local state and secrets that must not end up in an image.
.env
**/.env
dev-data/
data/
testclient-manifest.txt

crates/testclient/
